{
  "name": "jlpt-mobile",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "src/front"
  ],
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace src/front",
    "dev:local": "set \"JLPT_APP_ORIGIN=http://127.0.0.1:3100\" && npm run dev --workspace src/front -- --hostname 127.0.0.1 --port 3100",
    "setup:local": "npm ci --ignore-scripts && npm install --no-save --ignore-scripts @esbuild/win32-x64@0.28.2 @next/swc-win32-x64-msvc@16.4.3 @rolldown/binding-win32-x64-msvc@1.2.15 lightningcss-win32-x64-msvc@1.30.2 @tailwindcss/oxide-win32-x64-msvc@4.1.17 && npm run db:migrate && npm run db:seed",
    "build": "npm run build --workspace src/front",
    "db:migrate": "npm run db:migrate --workspace src/front",
    "db:seed": "npm run db:seed --workspace src/front",
    "db:backup": "npm run db:backup --workspace src/front",
    "lint": "npm run lint --workspace src/front",
    "typecheck": "npm run typecheck --workspace src/front",
    "test": "npm run test --workspace src/front",
    "benchmark": "npm run benchmark --workspace src/front",
    "test:e2e": "npm run test:e2e --workspace src/front"
  }
}
