# Runtime paths contain no secret values.
JLPT_DB_PATH=/app/var/jlpt.sqlite
JLPT_SEED_DATA=/app/seed-data
JLPT_BACKUP_DIR=/app/backup

# Docker host bind mounts and localhost-only port.
JLPT_DATA_DIR=./var
JLPT_BACKUP_HOST_DIR=./backups
JLPT_WEB_PORT=8081

# Canonical HTTPS origin used for write-request Origin checks.
JLPT_APP_ORIGIN=https://jlpt.example.com

# Server-to-server API. Generate a long random value; empty disables /api/v1.
JLPT_EXTERNAL_API_KEY=

# Durable listening storage and streaming upload limit.
JLPT_AUDIO_DIR=/app/var/listening/audio
JLPT_AUDIO_TMP_DIR=/app/var/listening/tmp
JLPT_MAX_AUDIO_BYTES=209715200
JLPT_LISTENING_WORKER_CONCURRENCY=1
JLPT_WEB_MEMORY_LIMIT=1g
JLPT_WORKER_MEMORY_LIMIT=2g
JLPT_FFPROBE_TIMEOUT_MS=15000
# FFPROBE_PATH=/usr/bin/ffprobe

# Optional remote transcription provider. Audio is not sent until this is set.
WHISPER_BASE_URL=
WHISPER_TRANSCRIBE_PATH=/api/v1/jobs
WHISPER_ALLOWED_HOSTS=
WHISPER_AUTH_TOKEN=
WHISPER_TIMEOUT_MS=600000

# Optional ChatGPT OAuth settings for the local open-source Responses API flow.
# The callback must use http://127.0.0.1 (not localhost) and match the running port.
JLPT_OPENAI_OAUTH_REDIRECT_URI=http://127.0.0.1:3100/api/openai/oauth/callback
JLPT_OPENAI_AGENT_NAME=JLPT Study
JLPT_OPENAI_AUTH_PATH=/app/var/openai-auth.json
