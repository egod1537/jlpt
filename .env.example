# Runtime paths contain no secret values.
JLPT_DB_PATH=/app/var/jlpt.sqlite
JLPT_SEED_DATA=/app/seed-data
JLPT_BACKUP_DIR=/app/var/backups

# Canonical HTTPS origin used for Origin and CSRF checks.
JLPT_APP_ORIGIN=https://jlpt.example.com

# Optional operational settings.
JLPT_SESSION_TTL_DAYS=30
JLPT_TRUST_PROXY=1
