{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "word.schema.json",
  "title": "JLPT vocabulary word",
  "type": "object",
  "required": [
    "id",
    "term",
    "reading",
    "meanings",
    "primaryMeaning",
    "nuance",
    "collectionIds",
    "sources",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^word-[a-f0-9]{12}$" },
    "term": { "type": "string", "minLength": 1 },
    "reading": { "type": ["string", "null"] },
    "meanings": { "type": "array", "items": { "type": "string" } },
    "primaryMeaning": { "type": ["string", "null"] },
    "nuance": { "type": ["string", "null"] },
    "partOfSpeech": { "type": "array", "items": { "type": "string" } },
    "jlptLevels": { "type": "array", "items": { "enum": ["N1", "N2", "N3", "N4", "N5"] } },
    "years": { "type": "array", "items": { "type": "integer", "minimum": 2000, "maximum": 2100 } },
    "categories": { "type": "array", "items": { "type": "string" } },
    "collectionIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "relatedTerms": { "type": "array", "items": { "type": "string" } },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ja", "ko"],
        "properties": {
          "ja": { "type": "string" },
          "ko": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["collectionId", "sourceType", "sourceFile"],
        "properties": {
          "collectionId": { "type": "string" },
          "sourceType": { "enum": ["attachment", "html-artifact", "conversation-recovery"] },
          "sourceFile": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "year": { "type": ["integer", "null"] },
          "section": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "status": { "enum": ["ready", "needs-review"] }
  },
  "additionalProperties": false
}
